{
    "name": "@byteowls/chartjs-gauge",
    "description": "Gauge for Chart.js v4+",
    "version": "1.0.0",
    "license": "MIT",
    "main": "dist/esm/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "keywords": [
        "chart.js",
        "gauge"
    ],
    "files": [
        "dist/"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/moberwasserlechner/chartjs-gauge"
    },
    "bugs": {
        "url": "https://github.com/moberwasserlechner/chartjs-gauge/issues"
    },
    "scripts": {
        "build": "npm run clean && tsc",
        "clean": "rimraf ./dist",
        "watch": "tsc --watch",
        "test": "jest",
        "removePacked": "rimraf -g byteowls-chartjs-gauge-*.tgz",
        "publishLocally": "npm run removePacked && npm run build && npm pack",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "chart.js": ">=4"
    },
    "devDependencies": {
        "@types/jest": "30.0.0",
        "ts-jest": "29.4.6",
        "rimraf": "6.1.2",
        "chart.js": "4.5.1",
        "typescript": "5.8.2"
    }
}
